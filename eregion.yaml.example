version: "1"

server:
  host: "0.0.0.0"
  port: 8080

  # Protege contra clientes que enviam headers muito lentamente.
  read_header_timeout: 10s

  # Tempo máximo para ler a requisição completa.
  read_timeout: 30s

  # Tempo máximo para escrever a resposta ao cliente.
  write_timeout: 30s

  # Tempo máximo de uma conexão HTTP keep-alive ociosa.
  idle_timeout: 60s

  # Tempo máximo para concluir requests em andamento durante o shutdown.
  shutdown_timeout: 20s

  # Limite total dos headers HTTP.
  max_header_bytes: 1048576 # 1 MiB

  # Limite do body HTTP recebido do cliente.
  max_body_bytes: 10485760 # 10 MiB

php:
  # Binário PHP CLI usado para iniciar os workers.
  binary: "php"

  # Worker genérico fornecido pelo MithrilPHP.
  worker_script: "vendor/ereborcodeforge/mithrilphp/bin/eregion-worker"

  # Diretório de trabalho usado pelos processos PHP.
  working_directory: "."

  # Variáveis adicionais repassadas aos workers.
  # O ambiente atual do processo deve ser preservado.
  environment:
    APP_ENV: "production"
    APP_DEBUG: "false"

workers:
  # Quantidade fixa de workers PHP persistentes.
  count: 4

  # Quantidade mínima de workers saudáveis para readiness positiva.
  min_ready: 1

  # Recicla o processo PHP depois desta quantidade de requests.
  # Use 0 para desativar.
  max_requests: 1000

  # Tempo máximo para o processo iniciar, criar o socket e aceitar dial.
  # Não inclui o handshake (ver handshake_timeout).
  startup_timeout: 10s

  # Tempo máximo para concluir o handshake EREGION/1 (HELLO/READY).
  handshake_timeout: 5s

  # Deadline de uma requisição já entregue ao worker.
  request_timeout: 30s

  # Tempo máximo aguardando um worker ficar livre (fila).
  acquire_timeout: 2s

  # Tempo dado ao worker para encerrar (SIGTERM → wait → SIGKILL).
  shutdown_timeout: 5s

  # Reciclagem cooperativa baseada na memória reportada pelo PHP.
  # Use 0 para desativar. Recycle planejado ≠ crash.
  memory_limit_mb: 256

  # Máximo de crashes/restarts não planejados dentro de restart_window.
  # Com limit=5, o 6º crash na janela marca o slot como Failed.
  restart_limit: 5

  # Janela usada para detectar crash loop.
  restart_window: 30s

  restart_backoff:
    # Espera inicial antes de reiniciar um worker que falhou.
    # O backoff é resetado após um boot bem-sucedido.
    initial: 100ms

    # Limite máximo do backoff.
    maximum: 5s

    # Multiplicador aplicado após cada falha.
    multiplier: 2.0

    # Variação aleatória para evitar reinicializações simultâneas.
    # 0.2 representa aproximadamente ±20%.
    jitter: 0.2

socket:
  # Diretório privado onde os sockets dos workers serão criados.
  directory: "/tmp/eregion"

  # Permissão do diretório.
  directory_permissions: "0700"

  # Permissão de cada arquivo de socket.
  socket_permissions: "0600"

protocol:
  # Versão do contrato Eregion ↔ MithrilPHP.
  version: 1

  # Transporte e codec são fixos no Eregion v1:
  # Unix Domain Socket + MessagePack.

  # Tamanho máximo de um frame interno completo.
  # Deve ser maior que server.max_body_bytes porque inclui headers e metadados.
  max_frame_bytes: 16777216 # 16 MiB

queue:
  # Quantidade máxima de requests esperando um worker.
  # Requests em execução não entram nessa contagem.
  # Admitidos no máximo = workers.count + queue.capacity.
  # capacity: 0 desativa a fila (só executa se houver worker livre; senão 503 imediato).
  capacity: 64

  # Valor enviado no header Retry-After (segundos, arredondado para cima, mín. 1).
  retry_after: 1s

logging:
  # debug, info, warn ou error.
  level: "info"

  # text ou json.
  format: "json"

  # Loga uma entrada resumida para cada request (inclui 413/503/504/502).
  access_log: true

  # Headers sensíveis (Authorization, Cookie, etc.) são sempre redigidos.
  include_request_headers: false

  # Bodies de log são truncados (8 KiB); binários são omitidos.
  include_request_body: false
  include_response_body: false

operations:
  # Prefixo dos endpoints internos. Paths relativos abaixo são unidos a este prefixo.
  # Paths absolutos que já começam com o prefixo são aceitos (compat legado).
  prefix: "/_eregion"

metrics:
  enabled: true
  path: "/metrics"

health:
  enabled: true
  path: "/health"

readiness:
  enabled: true
  path: "/ready"

liveness:
  enabled: true
  path: "/live"